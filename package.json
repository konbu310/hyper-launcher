{
  "type": "module",
  "name": "hyper-launcher",
  "description": "Flexible and powerful application launcher for macOS.",
  "author": "konbu310",
  "main": "dist/main/main.js",
  "license": "MIT",
  "scripts": {
    "rimraf": "rimraf",
    "start": "electron .",
    "watch": "npm-run-all 'rimraf dist' --parallel watch:* start",
    "watch:main": "node scripts/build.js -w",
    "watch:renderer": "vite dev",
    "build": "npm-run-all --parallel 'rimraf dist' 'rimraf build' --parallel build:*",
    "build:main": "node scripts/build.js --prd",
    "build:renderer": "NODE_ENV=production vite build",
    "prepack": "npm run build",
    "pack": "node scripts/pack.js",
    "archive": "node scripts/archive.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt --write '**/*.{ts,tsx}'"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "constate": "4.0.0",
    "electron-store": "11.0.2",
    "file-icon": "6.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@electron/packager": "20.0.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.0",
    "electron-reload": "2.0.0-alpha.1",
    "esbuild": "0.28.1",
    "esbuild-node-externals": "1.23.1",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  }
}
