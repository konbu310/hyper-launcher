{
  "type": "module",
  "name": "hyper-launcher",
  "description": "Flexible and powerful application launcher for macOS.",
  "author": "konbu310",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "version": "2.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --config ./electron-builder.config.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt --write '**/*.{ts,tsx}'"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "constate": "4.0.0",
    "electron-store": "11.0.2",
    "file-icon": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-electron": "1.1.2",
    "vite-plugin-electron-renderer": "1.0.0"
  }
}
